          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (uri, le) (rate(http_server_requests_seconds_bucket{environment=\"$env\",uri=~\"/mentorings/.*/reservation|/reservations/.*/approve\"}[$__rate_interval]))) * 1000",
          "legendFormat": "p95 응답 {{uri}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (uri, le) (rate(http_server_requests_seconds_bucket{environment=\"$env\",uri=~\"/mentorings/.*/reservation|/reservations/.*/approve\"}[$__rate_interval]))) * 1000",
          "legendFormat": "p99 응답 {{uri}}",
          "refId": "B"
        }
      ],
      "description": "예약 API의 p95/p99 응답 시간입니다. Outbox 전환 후 SMS 지연이 사용자 응답 시간에 섞이지 않는지 확인합니다.",
