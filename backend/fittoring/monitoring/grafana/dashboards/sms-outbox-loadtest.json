          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count{environment=\"$env\",uri=~\"/mentorings/.*/reservation|/reservations/.*/approve\"}[$__rate_interval]))",
          "legendFormat": "{{uri}} status={{status}}",
          "refId": "A"
        }
      ],
      "description": "예약 신청/승인 API가 초당 몇 건 처리되는지 봅니다. 부하가 올라가도 처리량이 목표 TPS 근처에서 유지되는지 확인합니다.",
      "title": "예약 API 요청량",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
